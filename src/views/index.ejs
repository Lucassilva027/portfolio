<!DOCTYPE html>
<html lang="<%= ui.htmlLang %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="<%= metaDescription %>" />
    <meta property="og:title" content="<%= pageTitle %>" />
    <meta property="og:description" content="<%= metaDescription %>" />
    <meta property="og:type" content="website" />
    <link rel="alternate" hreflang="en" href="/" />
    <link rel="alternate" hreflang="pt-BR" href="/pt" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <%
      const fp = featuredProject;
      const arcEmporio = allProjects.find((p) => p.id === "emporio-ai-agent") || primaryProjects[0];
      const arcPirate = allProjects.find((p) => p.id === "shooter-naval-2d") || primaryProjects[1];
      const restPrimary = primaryProjects.filter(
        (p) => p.id !== "emporio-ai-agent" && p.id !== "shooter-naval-2d"
      );
    %>

    <a class="skip-link" href="#mais-projetos"><%= ui.skipLink %></a>

    <section class="court-hero" id="topo" aria-label="<%= developer.name %>">
      <img
        class="court-hero__plate"
        src="/images/plates/court-floor.png"
        alt=""
        width="1920"
        height="1080"
        decoding="async"
        fetchpriority="high"
      />
      <div class="court-hero__scrim" aria-hidden="true"></div>
      <svg class="court-hero__shot" viewBox="0 0 100 60" aria-hidden="true" focusable="false">
        <path d="M8 52 C 28 10, 62 6, 92 18" fill="none" stroke="currentColor" stroke-width="0.45" />
        <circle cx="92" cy="18" r="1.1" fill="currentColor" />
      </svg>

      <header class="court-nav">
        <a class="court-nav__mark" href="#topo">LS</a>
        <nav class="court-nav__links" aria-label="<%= ui.nav.aria %>">
          <a href="#mais-projetos"><%= ui.nav.projects %></a>
          <a href="#stack"><%= ui.nav.stack %></a>
          <a href="#sobre"><%= ui.nav.about %></a>
          <a href="#prova"><%= ui.nav.proof %></a>
          <a href="#contato"><%= ui.nav.contact %></a>
        </nav>
        <div class="court-nav__actions">
          <div class="lang-switch" role="navigation" aria-label="<%= ui.langSwitch %>">
            <a
              href="/"
              class="lang-switch__link<%= locale === 'en' ? ' is-active' : '' %>"
              hreflang="en"
              >EN</a
            >
            <span class="court-nav__sep" aria-hidden="true">/</span>
            <a
              href="/pt"
              class="lang-switch__link<%= locale === 'pt' ? ' is-active' : '' %>"
              hreflang="pt-BR"
              >PT</a
            >
          </div>
          <a href="mailto:<%= developer.email %>"><%= ui.hero.ctaEmail %></a>
          <a href="<%= developer.whatsapp %>" target="_blank" rel="noopener noreferrer"
            ><%= ui.cta.whatsappBtn %></a
          >
        </div>
      </header>

      <div class="court-hero__grid">
        <div class="court-hero__intro">
          <h1 class="court-name"><%= developer.name %></h1>
          <p class="court-tagline">
            <% if (locale === "pt") { %>
            Desenvolvo web apps, <em>agentes de IA</em> e games de navegador.
            <% } else { %>
            I build web apps, <em>AI agents</em> and browser games.
            <% } %>
          </p>
        </div>

        <article class="court-spot court-spot--featured court-mark">
          <p class="court-kicker"><%= locale === "pt" ? "Projeto em destaque" : "Featured project" %></p>
          <h2 class="court-project-title"><%= fp.title %></h2>
          <p class="court-project-body"><%= fp.summaryLine %></p>
          <% if (fp.statusSub) { %>
          <p class="court-spot__status"><%= fp.statusSub %></p>
          <% } %>
          <div class="court-spot__actions">
            <% if (fp.link) { %>
            <a class="court-cta" href="<%= fp.link %>" target="_blank" rel="noreferrer"
              ><%= locale === "pt" ? "Ver projeto" : "View project" %></a
            >
            <% } %>
            <button type="button" class="court-cta court-cta--ghost" data-open-case="<%= fp.id %>">
              <%= ui.modal.kicker %>
            </button>
          </div>
        </article>

        <% if (arcEmporio) { %>
        <article class="court-spot court-spot--emporio court-mark">
          <p class="court-kicker"><%= locale === "pt" ? "Agente de IA" : "AI agent" %></p>
          <h2 class="court-project-title"><%= arcEmporio.title %></h2>
          <p class="court-project-body"><%= arcEmporio.summaryLine %></p>
          <button type="button" class="court-cta" data-open-case="<%= arcEmporio.id %>">
            <%= locale === "pt" ? "Explorar" : "Explore" %>
          </button>
        </article>
        <% } %>

        <% if (arcPirate) { %>
        <article class="court-spot court-spot--pirate court-mark">
          <p class="court-kicker"><%= locale === "pt" ? "Jogo de navegador" : "Browser game" %></p>
          <h2 class="court-project-title"><%= arcPirate.title %></h2>
          <p class="court-project-body"><%= arcPirate.summaryLine %></p>
          <% if (arcPirate.link) { %>
          <a class="court-cta" href="<%= arcPirate.link %>" target="_blank" rel="noreferrer"
            ><%= locale === "pt" ? "Jogar" : "Play" %></a
          >
          <% } %>
        </article>
        <% } %>
      </div>
    </section>

    <main>
      <div class="playbook-rail" aria-hidden="true">
        <svg class="playbook playbook--arc reveal" viewBox="0 0 200 80" focusable="false">
          <path d="M10 70 C 60 10, 140 10, 190 55" fill="none" stroke="currentColor" stroke-width="1.2" />
          <circle cx="190" cy="55" r="2.4" fill="currentColor" />
          <circle cx="10" cy="70" r="1.6" fill="currentColor" opacity="0.5" />
        </svg>
      </div>

      <section id="mais-projetos" class="section reveal">
        <div class="section-header section-header--with-clip">
          <svg class="clipboard-mark reveal" viewBox="0 0 64 80" aria-hidden="true" focusable="false">
            <rect x="10" y="14" width="44" height="56" rx="2" fill="none" stroke="currentColor" stroke-width="1.5" />
            <rect x="22" y="8" width="20" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.5" />
            <path d="M18 32 H46 M18 42 H40 M18 52 H44" stroke="currentColor" stroke-width="1.2" />
            <circle cx="48" cy="58" r="2" fill="currentColor" />
          </svg>
          <div>
            <p class="section-tag"><%= locale === "pt" ? "No arco" : "On the arc" %></p>
            <h2><%= ui.projects.tag %></h2>
            <p class="section-lead"><%= ui.projects.lead %></p>
          </div>
        </div>

        <div class="project-grid">
          <% restPrimary.forEach((project) => { %>
          <%- include('partials/project-card', { project: project, ui: ui }) %>
          <% }) %>
        </div>

        <% if (archiveProjects.length) { %>
        <details class="projects-archive reveal">
          <summary class="projects-archive__summary">
            <%= ui.projects.archiveSummary(archiveProjects.length) %>
          </summary>
          <p class="projects-archive__note"><%= ui.projects.archiveNote %></p>
          <div class="project-grid project-grid--archive">
            <% archiveProjects.forEach((project) => { %>
            <%- include('partials/project-card', { project: project, ui: ui, compactCard: true }) %>
            <% }) %>
          </div>
        </details>
        <% } %>
      </section>

      <div class="playbook-rail playbook-rail--right" aria-hidden="true">
        <svg class="playbook playbook--set reveal" viewBox="0 0 160 100" focusable="false">
          <circle cx="28" cy="72" r="7" fill="none" stroke="currentColor" stroke-width="1.3" />
          <circle cx="78" cy="38" r="7" fill="none" stroke="currentColor" stroke-width="1.3" />
          <circle cx="128" cy="58" r="7" fill="none" stroke="currentColor" stroke-width="1.3" />
          <path d="M35 68 L70 44 M85 42 L120 54" fill="none" stroke="currentColor" stroke-width="1.1" stroke-dasharray="3 3" />
          <path d="M28 65 C 48 20, 96 18, 128 50" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.7" />
        </svg>
      </div>

      <section id="stack" class="section reveal">
        <div class="section-header">
          <p class="section-tag"><%= ui.stack.tag %></p>
          <h2><%= ui.stack.title %></h2>
          <p class="section-lead"><%= ui.stack.lead %></p>
        </div>
        <ul class="stack-cloud" aria-label="<%= ui.stack.aria %>">
          <% profile.stackMain.forEach((tech) => { %>
          <li><%= tech %></li>
          <% }) %>
        </ul>
      </section>

      <section id="sobre" class="section reveal">
        <div class="section-header">
          <p class="section-tag"><%= ui.about.tag %></p>
          <h2><%= ui.about.title %></h2>
        </div>
        <div class="about-card">
          <p class="about-lead"><%= profile.aboutLead %></p>
          <p class="about-goal"><%= ui.about.goalLine %></p>
          <ul class="about-list">
            <% profile.aboutBullets.forEach((b) => { %>
            <li><%= b %></li>
            <% }) %>
          </ul>
        </div>
      </section>

      <section id="prova" class="section reveal">
        <div class="section-header">
          <p class="section-tag"><%= profile.proof.headline %></p>
          <h2><%= profile.proof.title %></h2>
          <p class="section-lead"><%= profile.proof.subline %></p>
        </div>
        <div class="proof-groups">
          <% profile.proof.sections.forEach((section) => { %>
          <div class="proof-group">
            <h3 class="proof-group__title"><%= section.title %></h3>
            <ul class="proof-list">
              <% section.items.forEach((item) => { %>
              <li class="proof-item">
                <a href="<%= item.href %>" target="_blank" rel="noopener noreferrer">
                  <span class="proof-item__label"><%= item.label %></span>
                  <span class="proof-item__detail"><%= item.detail %></span>
                </a>
              </li>
              <% }) %>
            </ul>
          </div>
          <% }) %>
        </div>
      </section>

      <section id="contato" class="section section-cta reveal">
        <p class="section-tag"><%= ui.cta.tag %></p>
        <h2><%= ui.cta.title %></h2>
        <p><%= ui.cta.body %></p>
        <div class="cta-row">
          <a
            class="btn btn-primary"
            href="mailto:<%= developer.email %>?subject=<%= encodeURIComponent(ui.cta.emailSubject) %>"
            ><%= ui.cta.emailBtn %></a
          >
          <a
            class="btn btn-whatsapp"
            href="<%= developer.whatsapp %>"
            target="_blank"
            rel="noopener noreferrer"
            ><%= ui.cta.whatsappBtn %></a
          >
          <a class="btn btn-secondary" href="<%= developer.linkedin %>"
            ><%= ui.cta.linkedinBtn %></a
          >
        </div>
      </section>
    </main>

    <% allProjects.forEach((p) => { %>
    <div
      class="case-modal"
      id="case-modal-<%= p.id %>"
      role="dialog"
      aria-modal="true"
      aria-hidden="true"
      hidden
    >
      <div class="case-modal__backdrop" data-close-case tabindex="-1"></div>
      <div
        class="case-modal__panel"
        role="document"
        aria-labelledby="case-modal-title-<%= p.id %>"
      >
        <button
          type="button"
          class="case-modal__close"
          data-close-case
          aria-label="<%= ui.modal.close %>"
        >
          ×
        </button>
        <p class="project-kicker"><%= ui.modal.kicker %></p>
        <h2 id="case-modal-title-<%= p.id %>"><%= p.title %></h2>
        <p class="role-pill role-pill--inline"><%= p.roleLabel %></p>
        <% if (p.statusSub) { %>
        <p class="project-status-sub"><%= p.statusSub %></p>
        <% } %>

        <%- include('partials/case-matrix', { project: p, headingTag: 'h3', labels: ui.matrix }) %>

        <h3 class="modal-heading"><%= ui.modal.objective %></h3>
        <p class="modal-text"><%= p.caseStudy.objective %></p>

        <h3 class="modal-heading"><%= ui.modal.process %></h3>
        <p class="modal-text"><%= p.caseStudy.process %></p>

        <h3 class="modal-heading"><%= ui.modal.decisions %></h3>
        <ul class="case-block__list">
          <% p.caseStudy.decisions.forEach((d) => { %>
          <li><%= d %></li>
          <% }) %>
        </ul>

        <h3 class="modal-heading"><%= ui.modal.result %></h3>
        <p class="modal-text"><%= p.caseStudy.outcomeDetail %></p>

        <div class="modal-actions">
          <% if (p.link) { %>
          <a class="btn btn-primary" href="<%= p.link %>" target="_blank" rel="noreferrer"
            ><%= p.linkLabel %></a
          >
          <% } %>
          <% if (p.repoLink) { %>
          <a
            class="btn btn-secondary"
            href="<%= p.repoLink %>"
            target="_blank"
            rel="noreferrer"
            ><%= p.repoLinkLabel %></a
          >
          <% } %>
          <a
            class="btn btn-ghost"
            href="mailto:<%= developer.email %>?subject=<%= encodeURIComponent(ui.modal.invite + ': ' + p.title) %>"
            ><%= ui.modal.invite %></a
          >
        </div>
      </div>
    </div>
    <% }) %>

    <script src="/js/main.js"></script>
  </body>
</html>
